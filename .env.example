# ==============================================================
# ACCUTAX - Environment Variables Template untuk Vercel
# ==============================================================
# CATATAN KEAMANAN:
# 1. File ini HANYA TEMPLATE (berisi data contoh/dummy).
# 2. JANGAN PERNAH mengisi password riil di file ini atau menyimpannya ke Git!
# 3. Masukkan variabel berikut secara langsung di:
#    Vercel Dashboard -> Proyek Anda -> Settings -> Environment Variables
# ==============================================================

# Kredensial Administrator (Format JSON string)
# Masukkan daftar admin dan password terenkripsi/aman di Environment Variable Vercel
ADMIN_USERS_JSON='[{"username":"admin","password":"GantiDenganPasswordAman","name":"Administrator","role":"admin"}]'

# Database Google Spreadsheet untuk Pendaftaran Pengguna (Google Apps Script Web App URL)
# Masukkan URL Deployment Google Apps Script (berakhiran /exec)
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxContohURLDeploymentGoogleScript/exec"

